# Datastore (see reference/migrations/ — apply 260-273 to a real Postgres instance)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Identity adapter (Privy) — https://docs.privy.io
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# RPC (Base mainnet / Base Sepolia). At least one is recommended; falls back
# to public endpoints otherwise.
ALCHEMY_API_KEY=
INFURA_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=

# --- Gateway (packages/agent-gateway) ---

# Canonical app origin. Used both as the World AgentKit resource/audience
# (see canonicalAgentkitResourceUrl in payments/x402.ts) and as the fallback
# for HEADLESS_AGENT_ISSUER/HEADLESS_AGENT_RESOURCE below.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Agent session signing. A dev fallback is used outside production.
AGENT_SESSION_JWT_SECRET=

# x402 payment facilitator and settlement recipient.
X402_FACILITATOR_URL=
X402_PAY_TO_ADDRESS=

# CDP-hosted x402 facilitator (used instead of X402_FACILITATOR_URL when both are set)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# World AgentKit identity-gated discount pricing (optional — falls back to
# full price if AgentKit wiring fails or WORLD_CHAIN_RPC_URL is unset)
WORLD_CHAIN_RPC_URL=
WORLD_AGENTBOOK_RELAY_URL=
AGENTKIT_DISCOUNT_PERCENT=50
AGENTKIT_DISCOUNT_USES=100

# Headless agent API / MCP / OAuth surface (optional; each flag independently
# gates its surface, all default to disabled)
HEADLESS_AGENT_API_ENABLED=false
HEADLESS_AGENT_AUTH_ENABLED=false
HEADLESS_AGENT_MCP_ENABLED=false
HEADLESS_AGENT_ISSUER=
HEADLESS_AGENT_RESOURCE=
HEADLESS_AGENT_JWT_KID=
HEADLESS_AGENT_JWT_PRIVATE_JWK=
HEADLESS_AGENT_JWT_PUBLIC_JWK=
HEADLESS_AGENT_CREDENTIAL_PEPPER_KID=
HEADLESS_AGENT_CREDENTIAL_PEPPERS=

# Rate limiting (Upstash Redis). Falls back to an in-memory limiter when unset,
# unless REQUIRE_REDIS_RATE_LIMIT=true.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
REQUIRE_REDIS_RATE_LIMIT=false

AGENT_MAX_NON_REVOKED_PER_OWNER=1

# --- Runner (packages/agent-runner, bin/agent.ts) ---

P2E_GATEWAY_URL=http://localhost:3000
P2E_OWNER_TOKEN=
AGENT_WALLET_PROVIDER=cdp
AGENT_NAME=
AGENT_LABEL=quest-runner
AGENT_PRIVATE_KEY=
AGENT_REWARD_WALLET=
CDP_WALLET_SECRET=
AGENT_RPC_URL=
AGENT_CHAIN_ID=8453
AGENT_X402_NETWORK=
AGENT_SLIPPAGE_BPS=
AGENT_MAX_FUNDING_SWAPS=
AGENT_POLL_INTERVAL_MS=30000
AGENT_CLAIM_FINALIZATION_BUFFER_SECONDS=120
AGENT_TEMPLATE_IDS=
AGENT_RUN_ID=
AGENT_DRY_RUN=false

# Optional AI narration. The runner falls back to deterministic narration when
# unset — no LLM key is required for correct execution.
AGENT_LLM_MODEL=
AGENT_LLM_FALLBACK_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_TIMEOUT_MS=

# The Graph — subgraph IDs served through the x402 gateway
# (packages/dg-vendor-subgraph is the DG Vendor one; deploy it yourself, or
# point at an already-deployed instance)
GRAPH_GATEWAY_URL=
GRAPH_VENDOR_SUBGRAPH_ID=
GRAPH_UNISWAP_SUBGRAPH_ID=

# --- Uniswap v3 fee path (src/vendor/uniswap) ---
NEXT_PUBLIC_UNISWAP_FEE_WALLET=
NEXT_PUBLIC_UNISWAP_FEE_BIPS=
NEXT_PUBLIC_BUILDER_CODE=
NEXT_PUBLIC_DG_VENDOR_ADDRESS=
NEXT_PUBLIC_DG_TOKEN_ADDRESS_BASE_MAINNET=
NEXT_PUBLIC_UP_TOKEN_ADDRESS_BASE_MAINNET=

# EAS attestation (optional — see src/adapters/attestation.ts)
NEXT_PUBLIC_ENABLE_EAS=false
NEXT_PUBLIC_QUEST_COMPLETION_SCHEMA_UID=

# Logging
LOG_LEVEL=
NEXT_PUBLIC_LOG_LEVEL=
